# ========================================
# FRONTEND PRODUCTION ENV — deploy/ template
# ========================================
# Copy this file to the server as the frontend's real .env and fill in
# real values there. NEVER commit the filled-in file — it is gitignored
# (see deploy/*.env in .gitignore) precisely because a previous copy of
# this file with real production secrets was committed by mistake.
# If you are the operator of this project: that old secret and the
# database password below must be treated as compromised and rotated.

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_THIS_TO_RANDOM_STRING_32_CHARS_MIN"
NEXTAUTH_URL="https://yourdomain.com"
BACKEND_URL="http://127.0.0.1:3001"
SERVER_API_URL="http://127.0.0.1:3001"
TZ="Asia/Jakarta"
NEXT_PUBLIC_TIMEZONE="Asia/Jakarta"
NEXT_PUBLIC_APP_NAME="Salfanet Radius"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_API_URL=""
