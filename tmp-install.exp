#!/usr/bin/expect -f
set timeout 600
set env(TERM) xterm

spawn bash -c "cd /root/salfanet-radius/frontend/vps-install && bash vps-installer.sh --env lxc"

# Step 0: Environment selection (auto-detected, just press enter for default)
expect {
    -re "Pilih \[1/2/3/4\]" {
        send "\r"
    }
    timeout {
        send "\r"
    }
}

# Application User Configuration - select option 1 (use existing user)
expect {
    "Select option" {
        send "\r"
    }
    timeout {
        send "\r"
    }
}

# IP confirmation
expect {
    "Gunakan IP ini" {
        send "\r"
    }
    timeout {
        send "\r"
    }
}

# Installation confirmation
expect {
    "Mulai instalasi" {
        send "\r"
    }
    timeout {
        send "\r"
    }
}

# Wait for installation to complete (up to 40 minutes)
set timeout 2400
expect {
    "INSTALASI SELESAI" {
        puts "\nINSTALL COMPLETED"
    }
    "All installation steps completed successfully" {
        puts "\nINSTALL COMPLETED"
    }
    timeout {
        puts "\nINSTALL TIMEOUT - checking..."
    }
    eof {
        puts "\nINSTALL PROCESS ENDED"
    }
}

# Wait a bit for final output
sleep 5
expect eof
