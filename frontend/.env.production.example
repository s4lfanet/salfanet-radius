# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env for production setup
# CRITICAL: Change all default values before deploying!

# ========================================
# TIMEZONE - CRITICAL for WIB handling
# ========================================
TZ="Asia/Jakarta"
NEXT_PUBLIC_TIMEZONE="Asia/Jakarta"

# ========================================
# APPLICATION CONFIGURATION
# ========================================
NEXT_PUBLIC_APP_NAME="Your ISP Name"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NODE_ENV="production"

# ========================================
# NEXTAUTH - CRITICAL SECURITY
# ========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_THIS_TO_RANDOM_STRING_32_CHARS_MIN"
NEXTAUTH_URL="https://yourdomain.com"

# ========================================
# BACKEND API
# ========================================
# Server-side URL (for SSR/generateMetadata)
SERVER_API_URL="http://127.0.0.1:3001"
# Client-side URL (empty = relative path via nginx)
NEXT_PUBLIC_API_URL=""
