# Timezone - CRITICAL for WIB handling
TZ="Asia/Jakarta"
NEXT_PUBLIC_TIMEZONE="Asia/Jakarta"

# App Configuration
NEXT_PUBLIC_APP_NAME="Your ISP Name"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Backend API URL (server-side, for SSR/generateMetadata)
# If empty, defaults to http://localhost:3001
SERVER_API_URL="http://localhost:3001"

# Backend API URL (client-side, empty = relative path via nginx)
NEXT_PUBLIC_API_URL=""
