# === Backend Environment ===

# Server
PORT=3001
NODE_ENV=production
CORS_ORIGINS=http://localhost:3000

# Database (MySQL/MariaDB — same as frontend)
DATABASE_URL="mysql://root:password@localhost:3306/salfanet_radius"

# Auth (must match frontend .env)
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
AGENT_JWT_SECRET=your-agent-jwt-secret
TECH_JWT_SECRET=your-tech-jwt-secret
ENCRYPTION_KEY=your-encryption-key

# Frontend URL (for callbacks, CORS, etc.)
FRONTEND_URL=http://localhost:3000

# FreeRADIUS
FREERADIUS_CONFIG_DIR=/etc/freeradius/3.0
FREERADIUS_LOG_FILE=/var/log/freeradius/radius.log
FREERADIUS_SERVICE=freeradius

# GenieACS
GENIEACS_NBI_URL=http://localhost:7557
GENIEACS_CWMP_URL=http://localhost:7547
GENIEACS_FS_URL=http://localhost:7567
GENIEACS_MONGODB_URI=mongodb://localhost:27017/genieacs
GENIEACS_USERNAME=
GENIEACS_PASSWORD=

# WhatsApp (Baileys service URL)
WA_SERVICE_URL=http://127.0.0.1:4000

# Email (SMTP — used by EmailService, but settings are also in DB)
# These are fallbacks if emailSettings table is empty
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Telegram
TELEGRAM_BOT_TOKEN=

# Payment Gateways
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENVIRONMENT=sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=http://localhost:3000
VAPID_CONTACT_EMAIL=admin@salfanet.id

# SSH (for VPN routing operations)
SSH_KEY_PATH=/root/.ssh/id_rsa

# Timezone
TZ=Asia/Jakarta
