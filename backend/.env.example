# Backend .env — copy to backend/.env and fill in real values.
# Source of truth for what these do: src/lib/env.ts (all server-only
# process.env access should go through that module).
#
# In production, a single .env lives at the monorepo root and is
# symlinked into both backend/.env and frontend/.env (see
# frontend/vps-install/install-app.sh, create_env_file()) — NEXTAUTH_SECRET
# in particular must be identical for both apps since the backend verifies
# the same NextAuth JWT the frontend issues.

# ─── Required ────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@127.0.0.1:3306/salfanet_radius?connection_limit=10&pool_timeout=20"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_THIS_TO_RANDOM_STRING_32_CHARS_MIN"
NEXTAUTH_URL="http://localhost:3000"

# ─── Timezone (CRITICAL — WIB handling across cron/billing) ──────────────
TZ="Asia/Jakarta"
NEXT_PUBLIC_TIMEZONE="Asia/Jakarta"

# ─── App / URLs ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Cron (cron-runner.ts ↔ backend API auth) ────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=""
# Only needed if cron-runner calls a backend on a different host/port
# CRON_API_URL="http://localhost:3001"
# CRON_API_KEY=""

# ─── RADIUS CoA (must match MikroTik/NAS RADIUS client config) ───────────
RADIUS_COA_SECRET=""
RADIUS_COA_PORT="3799"
# Public IP of this server, used to generate NAS config in the admin UI
RADIUS_SERVER_IP=""

# ─── Auth tokens (each falls back to NEXTAUTH_SECRET if unset) ───────────
# JWT_SECRET=""
# AGENT_JWT_SECRET=""

# ─── Encryption at rest (GenieACS password, VPN credentials in DB) ───────
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=""

# ─── Uploads ──────────────────────────────────────────────────────────
# UPLOAD_DIR="/var/www/salfanet-radius/public/uploads"

# ─── WireGuard (VPS built-in VPN routing, optional) ──────────────────────
# WG_IFACE="wg0"

# ─── Web Push (VAPID) — generate with: node scripts/generate-vapid.js ────
# VAPID_PRIVATE_KEY=""
# VAPID_CONTACT_EMAIL=""
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ─── Redis cache (optional — app degrades gracefully if unset/unreachable) ─
# REDIS_URL="redis://127.0.0.1:6379"

# ─── GenieACS TR-069 (optional — can also be configured in admin panel) ──
# GENIEACS_NBI_URL="http://127.0.0.1:7557"
# GENIEACS_NBI_USERNAME=""
# GENIEACS_NBI_PASSWORD=""
# NEXT_PUBLIC_GENIEACS_NBI_URL="http://127.0.0.1:7557"

# ─── Baileys WhatsApp gateway (wa-service.js, separate PM2 process) ──────
# WA_AUTH_DIR="/var/data/salfanet/baileys_auth"
# WA_SERVICE_PORT="4000"
