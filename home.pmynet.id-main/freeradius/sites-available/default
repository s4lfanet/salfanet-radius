server default {

# ─── Listen ports ────────────────────────────────────────────────────────────
# Port 11812/11813 agar tidak konflik dengan FreeRADIUS existing (1812/1813)

listen {
    type   = auth
    ipaddr = *
    port   = 11812
    limit {
        max_connections = 64
        lifetime        = 0
        idle_timeout    = 30
    }
}

listen {
    type   = acct
    ipaddr = *
    port   = 11813
    limit {
    }
}

# ─── Authorization ───────────────────────────────────────────────────────────
authorize {
    preprocess
    chap
    mschap
    digest
    suffix
    eap {
        ok = return
    }
    sql
    pap
}

# ─── Authentication ──────────────────────────────────────────────────────────
authenticate {
    Auth-Type PAP {
        pap
    }
    Auth-Type CHAP {
        chap
    }
    Auth-Type MS-CHAP {
        mschap
    }
    eap
}

# ─── Pre-Accounting ──────────────────────────────────────────────────────────
preacct {
    preprocess
    acct_unique
    suffix
    files
}

# ─── Accounting ──────────────────────────────────────────────────────────────
accounting {
    sql
    attr_filter.accounting_response
}

# ─── Session ─────────────────────────────────────────────────────────────────
session {
    sql
}

# ─── Post-Auth ───────────────────────────────────────────────────────────────
post-auth {
    update {
        &reply: += &session-state:
    }
    sql
    exec
    remove_reply_message_if_eap

    Post-Auth-Type REJECT {
        sql
        attr_filter.access_reject
        eap
        remove_reply_message_if_eap
    }

    Post-Auth-Type Challenge {
    }
}

pre-proxy {
}

post-proxy {
    eap
}

}
