sql {
    dialect = "mysql"
    driver = "rlm_sql_${dialect}"

    # DB pmyhome
    server = "127.0.0.1"
    port = 3306
    login = "pmyhome"
    password = "LNDjxje2YjKGJh7A"
    radius_db = "pmyhome"

    # Table names (standard FreeRADIUS)
    acct_table1        = "radacct"
    acct_table2        = "radacct"
    postauth_table     = "radpostauth"
    authcheck_table    = "radcheck"
    groupcheck_table   = "radgroupcheck"
    authreply_table    = "radreply"
    groupreply_table   = "radgroupreply"
    usergroup_table    = "radusergroup"

    # Read NAS clients from nas table (multi-tenant)
    read_clients = yes
    client_table = "nas"

    # Group attribute name used in queries.conf
    group_attribute = "SQL-Group"

    delete_stale_sessions = yes

    pool {
        start = 5
        min = 4
        max = 10
        spare = 3
        idle_timeout = 300
        lifetime = 0
        retry_delay = 30
        spread = no
    }

    # Use default MySQL queries bundled with FreeRADIUS
    $INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf
}
